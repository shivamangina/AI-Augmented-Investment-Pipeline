# Required
OPENAI_API_KEY=sk-...

# Optional — free token from https://api.producthunt.com/v2/oauth/applications
# (create an application, generate a "developer token" for your own account).
# If unset, Product Hunt sourcing is skipped with a warning; the pipeline
# still runs end-to-end on YC + Hacker News.
PRODUCTHUNT_API_TOKEN=

# Optional — override the OpenAI model used for analysis
OPENAI_MODEL=gpt-4o-mini
